#include <winver.h>

1 ICON "luxai.ico"
1 24 "luxai.manifest"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 3,1,0,1
 PRODUCTVERSION 3,1,0,1
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "BELGESELSEMO topluluk yapisi (resmi olmayan)"
            VALUE "FileDescription",  "LuxAI - Windows icin native yapay zeka asistani"
            VALUE "FileVersion",      "3.1.0.1"
            VALUE "InternalName",     "LuxAI"
            VALUE "LegalCopyright",   "Topluluk yapisi; LuxOS projesiyle baglantili degildir"
            VALUE "OriginalFilename", "LuxAI.exe"
            VALUE "ProductName",      "LuxAI"
            VALUE "ProductVersion",   "3.1.0-win.1"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
